<?xml version="1.0" encoding="utf-8" ?>
<odoo>

    <record id="view_sale_order_cancellation_tree" model="ir.ui.view">
        <field name="name">sale.order.cancellation.tree</field>
        <field name="model">sale.order.cancellation</field>
        <field name="arch" type="xml">
            <tree>
                <field name="sale_order_id" />
                <field name="partner_id" />
                <field name="received_at" />
            </tree>
        </field>
    </record>

    <record id="view_sale_order_cancellation_form" model="ir.ui.view">
        <field name="name">sale.order.cancellation.form</field>
        <field name="model">sale.order.cancellation</field>
        <field name="arch" type="xml">
            <form string="Cancellation Notice">
                <sheet>
                    <group>
                        <group>
                            <field name="sale_order_id" />
                            <field name="partner_id" />
                            <field name="received_at" />
                        </group>
                    </group>

                    <notebook>
                        <page string="Cancellation Reason">
                            <field name="cancellation_reason" readonly="1" />
                        </page>
                    </notebook>
                </sheet>

                <chatter />
            </form>
        </field>
    </record>

    <record id="action_sale_order_cancellation" model="ir.actions.act_window">
        <field name="name">Cancellation Notices</field>
        <field name="res_model">sale.order.cancellation</field>
        <field name="view_mode">tree,form</field>
    </record>

    <menuitem
        id="menu_sale_order_cancellation"
        name="Cancellation Notices"
        parent="sale.sale_order_menu"
        action="action_sale_order_cancellation"
        sequence="90"
        groups="sales_team.group_sale_manager"
    />

</odoo>
