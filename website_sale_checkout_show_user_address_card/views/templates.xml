<?xml version="1.0" encoding="utf-8" ?>
<odoo>
  <template id="checkout" inherit_id="website_sale.checkout">
    <!-- Kept outside #shop_checkout: the checkout interaction treats every
         .card inside it as a selectable address -->
    <xpath expr="//div[@id='shop_checkout']" position="before">
      <div
        t-if="not order.website_id.is_public_user()"
        id="checkout_user_address_card"
        class="mb-4"
      >
        <h5 class="mb-3">Customer</h5>
        <div class="card">
          <!-- Layout and badge follow core's portal.address_card -->
          <div
            class="card-body d-flex flex-column flex-md-row justify-content-between gap-2"
          >
            <t
              t-out="order.partner_id"
              t-options="dict(widget='contact', fields=['name', 'email', 'phone'], no_marker=True, no_tag_br=True)"
            />
            <div
              class="d-flex flex-row-reverse flex-md-column justify-content-between align-items-end"
            >
              <span
                t-if="order.partner_id == request.env.user.partner_id"
                class="badge text-bg-info"
              >Main Address</span>
              <div
                t-if="order.partner_id._can_be_edited_by_current_customer(order_sudo=order)"
                class="d-flex gap-1 mt-auto ms-n2 ms-md-auto me-auto me-md-n2 mb-n2"
              >
                <a
                  t-attf-href="/shop/address?partner_id={{ order.partner_id.id }}"
                  class="p-2"
                  role="button"
                  title="Edit"
                  aria-label="Edit"
                >
                  <i class="fa fa-fw fa-pencil" />
                </a>
              </div>
            </div>
          </div>
        </div>
      </div>
    </xpath>
  </template>
</odoo>
