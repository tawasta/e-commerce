<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <template id="checkout" inherit_id="website_sale.checkout">
        <!-- Piilotetaan core-h4:t -->
        <xpath expr="//div[@class='col-lg-12']/h4" position="attributes">
            <attribute name="class" position="add" separator=" ">d-none</attribute>
        </xpath>

        <!-- Lisätään selkeä Subscriber details -osio ennen ensimmäistä osoiteblokkia -->
        <xpath expr="//t[@t-call='website_sale.row_addresses']" position="before">
            <div class="row mb-3">
                <div class="col-lg-12">
                    <h4 class="mb-1">
                        <i class="fa fa-user me-2"/>
                        Subscriber details
                        <span class="badge bg-light text-dark border ms-2">Account owner</span>
                    </h4>
                    <p class="text-muted small mb-3">
                        These details identify who is placing the order. They can be different from the billing and delivery address.
                    </p>
                </div>

                <div class="col-lg-6 one_kanban_subscriber">
                    <div class="card border-primary h-100">
                        <div class="card-body d-flex flex-column" style="min-height: 150px;">
                            <div class="mb-2">
                                <span class="badge bg-primary">Used as account holder</span>
                            </div>

                            <t
                                t-esc="order.partner_id"
                                t-options="dict(widget='contact', fields=['name', 'address'], no_marker=True)"
                            />

                            <p class="text-muted small mt-2 mb-3">
                                Edit this only if you want to change the subscriber or customer account details.
                            </p>

                            <a
                                t-if="not actual_partner or (billing.id in actual_partner.child_ids.ids)"
                                t-attf-href="/shop/address?partner_id={{order.partner_id.id}}"
                                t-att-class="'btn btn-link p-0 no-decoration mt-auto'"
                                role="button"
                                title="Edit subscriber details"
                                aria-label="Edit subscriber details"
                            >
                                <i class="fa fa-pencil me-1"/>Edit subscriber details
                            </a>
                        </div>
                    </div>
                </div>
            </div>

            <div class="row mt-4 mb-2">
                <div class="col-lg-12">
                    <h4 class="mb-1">
                        <i class="fa fa-file-text-o me-2"/>
                        Billing address
                        <span class="badge bg-light text-dark border ms-2">Invoice</span>
                    </h4>
                    <p class="text-muted small mb-0">
                        Select the address used for billing.
                    </p>
                </div>
            </div>
        </xpath>

        <!-- Lisätään Delivery-otsikko shipping-blokin sisään -->
        <xpath expr="//t[@t-if='not only_services' and @groups='account.group_delivery_invoice_address']/div[@class='row']/div[@class='col-lg-12']" position="inside">
            <p class="text-muted small mb-0 mt-1">
                Select the address where the order will be delivered.
            </p>
        </xpath>

        <!-- Muutetaan shipping-otsikon teksti -->
        <xpath expr="//t[@t-if='not only_services' and @groups='account.group_delivery_invoice_address']//h4" position="inside">
            <span>Delivery address</span>
            <span class="badge bg-light text-dark border ms-2">Delivery</span>
        </xpath>
    </template>

    <template id="address_kanban_inherit" inherit_id="website_sale.address_kanban">
        <xpath expr="//a[contains(@class, 'js_edit_address')]" position="attributes">
            <!-- Piilotetaan painike, jos order.partner_id == contact.id -->
            <attribute
                name="t-if"
            >mode == 'billing' and order.partner_id.id != contact.id</attribute>
        </xpath>

        <xpath expr="//a[contains(@class, 'js_edit_address')]" position="attributes">
            <attribute name="title">Edit billing address</attribute>
            <attribute name="aria-label">Edit billing address</attribute>
        </xpath>

        <xpath expr="//div[contains(@class, 'card-body')]/t[@t-esc='contact']" position="before">
            <div class="mb-2">
                <span t-if="mode == 'billing'" t-attf-class="badge #{selected and 'bg-light text-primary' or 'bg-light text-dark border'}">
                    Billing address
                </span>
                <span t-if="mode == 'shipping'" t-attf-class="badge #{selected and 'bg-light text-primary' or 'bg-light text-dark border'}">
                    Delivery address
                </span>
            </div>
        </xpath>

        <xpath expr="//div[contains(@class, 'card-body')]/t[@t-esc='contact']" position="after">
            <p t-if="mode == 'billing'" t-attf-class="small mt-2 mb-2 #{selected and 'text-white-50' or 'text-muted'}">
                Used for billing.
            </p>
            <p t-if="mode == 'shipping'" t-attf-class="small mt-2 mb-2 #{selected and 'text-white-50' or 'text-muted'}">
                Used as the delivery address for this order.
            </p>
        </xpath>
    </template>

    <template id="row_addresses_inherit" inherit_id="website_sale.row_addresses">
        <xpath
            expr="//div[contains(@class, 'one_kanban') and contains(@class, 'col-md') and @t-if]"
            position="after"
        >
            <div
                class="one_kanban col-md"
                t-if="order.website_id.is_public_user() and is_invoice"
            >
                <t t-if="is_invoice">
                    <t t-set="new_address_href" t-valuef="/shop/address?mode=billing" />
                </t>
                <a
                    role="button"
                    t-att-href="new_address_href"
                    class="o_wsale_add_address d-flex align-items-center justify-content-center h-100 px-4 border rounded mx-auto no-decoration"
                >
                    <i class="fa fa-plus me-md-2" /><span
                        class="d-none d-md-inline"
                    >Add address</span>
                </a>
            </div>
        </xpath>
    </template>

</odoo>
