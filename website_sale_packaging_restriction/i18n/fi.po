#. module: website_sale_packaging_restriction
#. odoo-python
#: code:addons/website_sale_packaging_restriction/models/sale_order.py:0
msgid ""
"%(product)s cannot be bought in %(uom)s. Please remove it from your cart and"
" add it again."
msgstr ""
"Tuotetta %(product)s ei voi ostaa yksikössä %(uom)s. Poista se ostoskorista "
"ja lisää se uudelleen."

#. module: website_sale_packaging_restriction
#: model_terms:ir.ui.view,arch_db:website_sale_packaging_restriction.product_template_form_view
msgid "All"
msgstr "Kaikki"

#. module: website_sale_packaging_restriction
#: model:ir.model.fields,field_description:website_sale_packaging_restriction.field_product_product__website_uom_ids
#: model:ir.model.fields,field_description:website_sale_packaging_restriction.field_product_template__website_uom_ids
msgid "eCommerce Packagings"
msgstr "Verkkokaupan pakkaukset"

#. module: website_sale_packaging_restriction
#. odoo-python
#: code:addons/website_sale_packaging_restriction/models/product_template.py:0
msgid ""
"The eCommerce packagings of %(product)s must be its unit or one of its "
"packagings."
msgstr ""
"Tuotteen %(product)s verkkokaupan pakkausten täytyy olla sen yksikkö tai "
"jokin sen pakkauksista."

#. module: website_sale_packaging_restriction
#: model:ir.model.fields,help:website_sale_packaging_restriction.field_product_product__website_uom_ids
#: model:ir.model.fields,help:website_sale_packaging_restriction.field_product_template__website_uom_ids
msgid ""
"Units and packagings in which this product can be bought on eCommerce. Leave"
" empty to allow all of them."
msgstr ""
"Yksiköt ja pakkaukset, joissa tuotteen voi ostaa verkkokaupasta. Jätä "
"tyhjäksi, jos kaikki ovat sallittuja."
