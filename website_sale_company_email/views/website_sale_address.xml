<?xml version="1.0" encoding="utf-8" ?>
<odoo>
  <template
    id="address_b2b"
    name="Address Management company email"
    inherit_id="portal.address_form_fields"
  >
    <xpath expr="//div[@id='div_email']" position="after">
      <div id="div_company_email" class="col-lg-6 mb-2">
        <label class="col-form-label" for="o_company_email">Company Email</label>
        <input
          id="o_company_email"
          type="email"
          name="company_email"
          t-att-value="partner_sudo.company_email"
          class="form-control"
        />
      </div>
    </xpath>
  </template>
</odoo>
