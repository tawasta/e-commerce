<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <template id="address_inherit_birth_year" inherit_id="website_sale.address">
        <xpath expr="//select[@id='country_id']//.." position="after">
            <t t-if="has_membership_product">
                <div class="form-group col-lg-6 mb-2">
                    <label
                        class="col-form-label"
                        for="year_of_birth"
                    >Year of Birth</label>
                    <input
                        name="year_of_birth"
                        class="form-control"
                        type="number"
                        t-att-value="current_year_of_birth or None"
                    />
                </div>
            </t>
        </xpath>
    </template>
</odoo>
