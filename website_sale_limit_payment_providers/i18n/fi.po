#. module: website_sale_limit_payment_providers
#: model:ir.model.fields,field_description:website_sale_limit_payment_providers.field_product_product__allowed_payment_provider_ids
#: model:ir.model.fields,field_description:website_sale_limit_payment_providers.field_product_template__allowed_payment_provider_ids
msgid "Allowed payment providers"
msgstr "Sallitut maksutavat"

#. module: website_sale_limit_payment_providers
#: model:ir.model.fields,help:website_sale_limit_payment_providers.field_payment_provider__website_show_company
msgid "If partner is company type or has VAT-code, it's treated as a company"
msgstr "Jos kumppani on tyyppiä 'yritys' ja sillä on VAT-tunnus, kumppania pidetään yrityksenä."

#. module: website_sale_limit_payment_providers
#: model:ir.model.fields,help:website_sale_limit_payment_providers.field_payment_provider__website_show_private
msgid ""
"If partner is not company type and has no VAT-code, it's treated as a "
"private customer"
msgstr "Jos kumppani ei ole tyyppiä 'yritys' ja sillä ei ole VAT-tunnusta, kumppania pidetään yksityishenkilönä."

#. module: website_sale_limit_payment_providers
#: model:ir.model.fields,help:website_sale_limit_payment_providers.field_product_product__allowed_payment_provider_ids
#: model:ir.model.fields,help:website_sale_limit_payment_providers.field_product_template__allowed_payment_provider_ids
msgid "Leaving this empty will allow any provider to be used"
msgstr ""
"Jos tämän jättää tyhjäksi, tuotteen voi maksaa millä tahansa maksutavalla"

#. module: website_sale_limit_payment_providers
#: model:ir.model,name:website_sale_limit_payment_providers.model_payment_provider
msgid "Payment Provider"
msgstr "Maksupalveluntarjoaja"

#. module: website_sale_limit_payment_providers
#: model:ir.model,name:website_sale_limit_payment_providers.model_product_template
msgid "Product"
msgstr "Tuote"

#. module: website_sale_limit_payment_providers
#: model:ir.model.fields,help:website_sale_limit_payment_providers.field_payment_provider__website_show_for_group_ids
msgid ""
"Use to e.g. limit invoice-based paying only to signed in (portal) users. If "
"field is left empty, payment provider is shown for all groups' users."
msgstr ""
"Käytä esim. rajaamaan tietty maksutapa vain kirjautuneille (portaali-)käyttäjille. Jos kenttä "
"on tyhjä, maksutapan näkyvyyttä ei rajoiteta käyttäjäryhmien perusteella. "

#. module: website_sale_limit_payment_providers
#: model:ir.model.fields,field_description:website_sale_limit_payment_providers.field_payment_provider__website_show_company
msgid "Visible for companies"
msgstr "Näytetään yrityksille"

#. module: website_sale_limit_payment_providers
#: model:ir.model.fields,field_description:website_sale_limit_payment_providers.field_payment_provider__website_show_for_group_ids
msgid "Visible for only customers in groups"
msgstr "Näytetään vain tiettyjen käyttäjäryhmien asiakkaille"

#. module: website_sale_limit_payment_providers
#: model:ir.model.fields,field_description:website_sale_limit_payment_providers.field_payment_provider__website_show_private
msgid "Visible for private customers"
msgstr "Näytetään yksityishenkilöille"
